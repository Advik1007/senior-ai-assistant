# Copy to `.env.local` for local dev. On Vercel, add the same keys in
# Project → Settings → Environment Variables → Production, then Redeploy.
#
# Or run: npm run vercel:env

# Send login mail with Gmail SMTP (hello.unkai@gmail.com).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello.unkai@gmail.com
SMTP_FROM=UNK AI <hello.unkai@gmail.com>
# 16-character App Password from https://myaccount.google.com/apppasswords
SMTP_PASS=

# Vercel production frontend (Android + login emails):
# APP_URL=https://senior-ai-assistant.vercel.app
# CAPACITOR_SERVER_URL=https://senior-ai-assistant.vercel.app

# Android emulator + local dev:
# CAPACITOR_SERVER_URL=http://10.0.2.2:43141

# Signs email login and device-alert links (server-side only).
AUTH_SECRET=
APP_URL=https://senior-ai-assistant-git-main-advik1007.vercel.app
CAPACITOR_SERVER_URL=https://senior-ai-assistant-git-main-advik1007.vercel.app
CONTACT_EMAIL=
INBOX_SECRET=
# Required in production to call GET /api/auth/status (Authorization: Bearer <INBOX_SECRET>).

# Optional Talk replies (server-side only).
# GEMINI_API_KEY=
# AI_API_KEY=
# AI_MODEL=

# Speech-to-text for /api/transcribe (server-side only).
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# ElevenLabs conversational agent.
# ELEVENLABS_AGENT_ID=

# Blinkit (quick-commerce) key for Shopping.
# QUICKCOMMERCE_API_KEY=
