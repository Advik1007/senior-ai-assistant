# Copy this file to `.env.local` for local secrets.
# Never put real keys in frontend code.

# Optional. When set, a later version can call a real AI provider from /api/ai.
AI_API_KEY=

# Resend email (server-side only; never use a NEXT_PUBLIC_ prefix).
RESEND_API_KEY=
RESEND_FROM_EMAIL="UNK AI <onboarding@resend.dev>"
CONTACT_EMAIL=
EMAIL_TEST_RECIPIENT=
APP_URL=http://127.0.0.1:43141

# --- Vercel (production) ---
# Use your real Vercel URL everywhere (dashboard + local Android build):
# APP_URL=https://YOUR-PROJECT.vercel.app
# CAPACITOR_SERVER_URL=https://YOUR-PROJECT.vercel.app

# --- Android local dev only (emulator) ---
# CAPACITOR_SERVER_URL=http://10.0.2.2:43141

# Signs email login and device-alert links (server-side only).
AUTH_SECRET=
DEVICE_ALERT_SECRET=

# Local SQLite database for accounts (created automatically).
# DATABASE_URL=file:./data/unk.db
