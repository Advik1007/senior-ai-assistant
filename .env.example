# Copy this file to `.env.local` for local secrets.
# Never put real keys in frontend code.

# Optional. When set, a later version can call a real AI provider from /api/ai.
AI_API_KEY=

# Resend email (server-side only; never use a NEXT_PUBLIC_ prefix).
RESEND_API_KEY=
RESEND_FROM_EMAIL="UNK AI <onboarding@resend.dev>"
CONTACT_EMAIL=
EMAIL_TEST_RECIPIENT=
APP_URL=http://127.0.0.1:43141

# Optional. Authorized cab / flight / bill / healthcare APIs go here later.
# CAB_API_KEY=
# FLIGHT_API_KEY=
# BBPS_API_KEY=
# HEALTHCARE_API_KEY=
