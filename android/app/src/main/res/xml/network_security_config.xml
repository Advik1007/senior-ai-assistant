<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allows local dev (emulator 10.0.2.2, LAN IP) over HTTP. Use HTTPS in production. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
