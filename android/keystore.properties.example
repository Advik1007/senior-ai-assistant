# Copy to android/keystore.properties (never commit that file).
# Generate a keystore once:
#
#   keytool -genkeypair -v \
#     -keystore android/unk-release.keystore \
#     -alias unk-release \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass 'CHANGE_ME' -keypass 'CHANGE_ME' \
#     -dname "CN=UNK AI, OU=Mobile, O=UNK AI, L=Unknown, ST=Unknown, C=IN"
#
# Then fill:

storeFile=unk-release.keystore
storePassword=CHANGE_ME
keyAlias=unk-release
keyPassword=CHANGE_ME
